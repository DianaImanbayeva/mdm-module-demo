# Единый порт модуля (frontend + backend + /health) — договорено: 9009.
PORT=9009

# Секрет для проверки SSO-токена от ERP Core (тот же JWT_SECRET, что и у ERP —
# см. корневой MODULE_DEVELOPER_GUIDE.md).
JWT_SECRET=change-me

# Общий self-hosted Supabase (тот же инстанс, где живут схемы erp/warehouse).
# Собственные данные MDM — в схеме "mdm" (см. supabase/001_mdm_schema.sql).
SUPABASE_REST_URL=http://10.66.0.105:8000/rest/v1
SUPABASE_SERVICE_ROLE_KEY=change-me
MDM_SCHEMA=mdm

# Включает служебный эндпоинт POST /dev/login (тестовый SSO-токен для локальной
# разработки без настоящего ERP). В проде обязательно false.
DEV_MODE=true
