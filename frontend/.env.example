# Показывать ли на экране входа кнопку "Тестовый вход" (POST /dev/login на
# backend) для локальной проверки без настоящего SSO от ERP. В проде — false.
VITE_DEV_MODE=true

# Только для "npm run dev" (vite proxy) — куда пробрасывать /api, /health, /dev.
# В собранном проде фронтенд отдаётся тем же backend'ом на одном порту, эта
# переменная не участвует.
MDM_BACKEND_URL=http://localhost:9009
